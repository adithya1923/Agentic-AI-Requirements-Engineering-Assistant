# PostgreSQL container and local backend connection
POSTGRES_DB=requirements_assistant
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_with_a_local_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=requirements_assistant
DATABASE_USER=app_user
DATABASE_PASSWORD=replace_with_a_local_password

# Backend
API_PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173
UPLOAD_STORAGE_DIR=storage/uploads
MAX_UPLOAD_BYTES=10485760
MAX_INPUT_CHARS=100000
MAX_EXTRACTED_CHARS=1000000
MAX_PDF_PAGES=200

# Phase 4 local embeddings and knowledge uploads
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=embeddinggemma
OLLAMA_TIMEOUT_MS=120000
KB_DOCUMENT_EMBEDDING_PREFIX=title: {title} | text: {text}
KB_QUERY_EMBEDDING_PREFIX=task: search result | query: {query}
KB_UPLOAD_STORAGE_DIR=storage/knowledge
KB_MAX_CHUNK_CHARS=1200
KB_CHUNK_OVERLAP_CHARS=150
KB_MAX_SEARCH_TOP_K=20
